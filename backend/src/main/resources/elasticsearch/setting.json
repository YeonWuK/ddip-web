{
  "analysis": {
    "tokenizer": {
      "custom_nori_tokenizer": {
        "type": "nori_tokenizer",
        "decompound_mode": "mixed"
      }
    },
    "filter": {
      "autocomplete_edge": {
        "type": "edge_ngram",
        "min_gram": 2,
        "max_gram": 8
      }
    },
    "analyzer": {
      "custom_nori_analyzer": {
        "type": "custom",
        "tokenizer": "custom_nori_tokenizer",
        "filter": ["lowercase", "nori_part_of_speech"]
      },
      "custom_autocomplete_index": {
        "type": "custom",
        "tokenizer": "whitespace",
        "filter": ["lowercase", "autocomplete_edge"]
      },
      "custom_autocomplete_search": {
        "type": "custom",
        "tokenizer": "whitespace",
        "filter": ["lowercase"]
      }
    }
  }
}